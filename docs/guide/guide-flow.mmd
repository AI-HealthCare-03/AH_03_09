      subgraph FE ["Frontend"]
          direction TB
          f1["OCR 결과 확인·수정\n약물명·질병코드 검토"]
          f2["가이드 생성 요청"]
          f3["job_id 수신\n202 Accepted"]
          f4["상태 폴링\nPENDING → DONE / FAILED"]
          f5["가이드 조회 화면\nGuideResponse 렌더링"]
          f6["피드백 제출\n이해도·유용성"]
          f7["챗봇 화면\n가이드 기반 질의응답"]
          ffail["가이드 생성 실패 표시"]
      end

      subgraph API ["FastAPI Backend - API Layer"]
          direction TB
          b1["POST /guides/generate\n요청 수신 · job_id 반환\nRedis Pub/Sub publish"]
          b2["GET /guides/status/{job_id}\nJob 상태 조회"]
          b3["GET /guides/{guide_id}\nDB 조회"]
          b4["POST /feedback\n피드백 저장"]
          b5["GET /context\nGuideContext 생성"]
      end

      subgraph RD ["Redis"]
          direction TB
          r_pub["guide:request:{job_id}\nPub/Sub 채널 발행"]
          r_sub["guide:request:*\nAI Worker subscribe"]
          r1["guide:job:{job_id}\nJob PENDING"]
          r2["Job PROCESSING"]
          r3["Job DONE + guide_id"]
          r4["Job FAILED\n+ error_message"]
      end

      subgraph WK ["AI Worker - Guide Task"]
          direction TB
          w0["process_guide_task 시작"]
          w1["Health Profile 조회\n기저질환·혈압·생활습관"]
          w3["LLM 입력\n약물명 + 질병코드 원본 + Health Profile\nwhitelist 필터 적용"]
          wd{"drug_master\nDB 매칭?"}
          w4["복약 정보 추출 + 요약\n용법·주의사항·이상반응"]
          w5["NOT_FOUND 처리\n약물 정보 없음\nLLM 생성 제외"]
          wst{"복용 시간\n정보 있음?"}
          w6a["시간대별 그룹 구성\n아침·점심·저녁"]
          w6b["처방전·약봉투 안내 참고"]
          w7["GuideResponse 조립\n전체 가이드 통합"]
          w8["guides 테이블 저장\nPostgreSQL INSERT"]
      end

      subgraph PG ["PostgreSQL"]
          direction TB
          p1["health_profiles\n기저질환·혈압·생활습관"]
          p2["drug_master\n약물 용법·주의사항"]
          p3["guides 테이블\nJSONB 전체 저장"]
          p4["guides.feedback_data\n피드백 저장"]
      end

      subgraph AI ["OpenAI GPT-4o-mini - 순차 실행"]
          direction TB
          l1["1. 생활 가이드 생성\n생활관리 팁 4개"]
          l2["2. 식사 가이드 생성\n권장·금지식품 + 수분"]
          l3["3. 운동 가이드 생성\n강도·빈도·주의사항"]
          l4["복약 요약 LLM 보강\n키워드 기반 → GPT 정제"]
      end

      f1 --> f2
      f2 --> b1
