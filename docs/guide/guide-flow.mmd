      b1 -->|job_id 반환| f3

      r_pub --> r_sub
      r_sub -->|guide task dispatched| w0

      w0 -->|Redis PROCESSING| r2
      w0 --> w1

      w1 --> p1
      w1 --> w3

      w3 --> l1
      l1 --> l2
      l2 --> l3
      l3 --> w7

      w3 --> wd
      wd -->|성공| w4
      wd -->|실패 NOT_FOUND| w5
      wd -.->|DB 조회| p2
      w4 --> l4
      l4 --> w7
      w5 --> w7

      w3 --> wst
