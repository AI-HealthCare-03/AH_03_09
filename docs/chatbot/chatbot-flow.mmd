flowchart TD

    %% ── 가이드 연동 (사전 설정) ───────────────────────────────────────
    subgraph GUIDE["📋 가이드 연동 (사전 설정)"]
        G1([OCR 처방전 확인]) --> G2["POST /guides/jobs\n가이드 생성 요청"]
        G2 --> G3["navigate('/health-guide?job_id=xxx')\n※ URL 파라미터 → 새로고침해도 유지"]
        G3 --> G4["폴링\nGET /guides/jobs/{job_id}/status"]
        G4 --> G5{status === DONE?}
        G5 -- NO --> G4
        G5 -- YES --> G6["GET /guides/{guide_id}\n가이드 로드"]
        G6 --> G7["✅ chatStore.guideId 즉시 저장\n버튼 클릭 없이도 저장됨\n(localStorage 영속)"]
    end

    %% ── 챗봇 진입 ─────────────────────────────────────────────────────
    G7 --> START
    START([👤 사용자 메시지 입력]) --> FE1

    %% ══════════════════════════════════════════════════════════════
    subgraph FE["🖥 프론트엔드 (React + Zustand)"]
        FE1{세션 있음?}
        FE1 -- NO --> FE2["POST /chat/sessions\n제목 = 첫 메시지 앞 20자"]
        FE2 --> FE3[세션 ID 저장\nZustand + localStorage]
        FE1 -- YES --> FE4
        FE3 --> FE4["POST /sessions/{id}/messages/stream\nbody: content + guide_id\n※ retry 시에도 guide_id 유지"]
        FE4 --> FE5{응답 10초 초과?}
        FE5 -- YES --> FE6["⏳ 지연 안내 표시\n'AI 응답이 지연되고 있습니다'"]
        FE5 -- NO --> BE1
        FE6 --> BE1
    end

    %% ══════════════════════════════════════════════════════════════
    subgraph BE["⚙️ FastAPI 백엔드"]
        BE1{JWT 인증}
        BE1 -- 실패 --> BE2[401 반환]
        BE1 -- 성공 --> BE3{위험 키워드?\n자살·자해·극단적선택·과다복용}
        BE3 -- YES --> BE4["🚨 즉시 반환 (LLM 미호출)\n📞 자살예방상담전화 1393\n📞 정신건강위기상담전화 1577-0199\n119 응급 안내"]
        style BE4 fill:#fee2e2,stroke:#f87171,color:#111
        BE3 -- NO --> BE5{부적절 키워드?\n욕설·비속어}
        BE5 -- YES --> BE6["❌ 답변 거부\n약 관련 질문만 안내"]
        style BE6 fill:#f1f5f9,stroke:#94a3b8,color:#111
        BE5 -- NO --> BE7["건강 프로필 조회\n성별·나이·신체정보\n기저질환·혈압·알레르기\n복용약·생활습관"]
        BE7 --> BE8{guide_id 있음?}
        BE8 -- YES --> BE9["가이드 컨텍스트 조회\n처방 약물 / 복약 스케줄\n주요 지시사항\n질병코드+병명 (별도 섹션)"]
        style BE9 fill:#eff6ff,stroke:#60a5fa,color:#111
        BE8 -- NO --> BE10
        BE9 --> BE10["메시지 DB 저장\nRedis Publish\nchat:request:{session_id}"]
    end

    %% ══════════════════════════════════════════════════════════════
    subgraph AI["🤖 AI Worker"]
        BE10 --> AI1["스킬 감지\n(키워드 우선순위 매칭)"]

        AI1 --> SK1["🚑 EMERGENCY\n호흡곤란·경련·쇼크·119·과다"]
        AI1 --> SK2["💊 DRUG_INTERACTION\n병용·상호작용·함께 먹어"]
        AI1 --> SK3["⚠️ SIDE_EFFECT\n부작용·두통·구역·두드러기"]
        AI1 --> SK4["📋 MEDICATION_GUIDE\n복용법·식전·식후·처방전·약봉투"]
        AI1 --> SK5["🔍 DISEASE_INQUIRY\n내 병명·무슨 병·진단명·내 진단"]
        AI1 --> SK6["💬 GENERAL\n그 외"]

        SK5 --> DI["출처 분리 강제 프롬프트\n────────────────\n① 건강 프로필 →\n   '귀하께서 입력하신 건강정보에는\n   고혈압 정보가 포함되어 있습니다.'\n② OCR 질병코드 →\n   '올려주신 처방전에서 인식된\n   질병코드는 K29(위염)입니다.'"]
        style DI fill:#f0fdf4,stroke:#86efac,color:#111

        SK1 & SK2 & SK3 & SK4 & DI & SK6 --> AI2

        AI2["시스템 프롬프트 빌드\n① 스킬 프롬프트\n② 건강 프로필 섹션 (사용자 직접 입력)\n③ 처방 가이드 섹션 (복약 정보)\n④ 질병코드 섹션 (OCR 인식, 별도 분리)\n⑤ 출처 구분 규칙 + 확정 진단 금지\n⑥ 대화 순서 참조 규칙"]

        AI2 --> AI3{히스토리 12개 초과?}
        AI3 -- YES --> AI4["이전 대화 요약\n질문 순서 보존\n최근 8개 유지"]
        AI3 -- NO --> AI5
        AI4 --> AI5["OpenAI 스트리밍 호출"]
        AI5 --> AI6["청크 Redis Publish\nchat:stream:{session_id}\n+ 스킬별 면책 문구 자동 추가"]
    end

    %% ══════════════════════════════════════════════════════════════
    subgraph RES["🖥 프론트엔드 (응답 수신)"]
        AI6 --> R1["NDJSON 청크 수신\n실시간 UI 표시"]
        R1 --> R2(["💬 답변 완료\n메시지·세션 목록 갱신"])
    end
