flowchart TD

    %% ── 가이드 연동 ───────────────────────────────────────────────────
    subgraph GUIDE["📋 가이드 연동 (사전 설정)"]
        G1([OCR 처방전 확인]) --> G2["POST /guides/jobs\n가이드 생성 요청"]
        G2 --> G3["폴링 GET /guides/jobs/{job_id}/status"]
        G3 --> G4{status === DONE?}
        G4 -- NO --> G3
        G4 -- YES --> G5["chatStore.guideId 저장\n(localStorage 영속)"]
    end

    %% ── 챗봇 진입 (빈 화면) ─────────────────────────────────────────
    G5 --> START
    START([👤 챗봇 진입]) --> ES1

    subgraph ES["🖥 Empty State (가이드 선택)"]
        ES1{guide_id 있음?}
        ES1 -- YES --> ES2["처방전 가이드 연동 안내 표시"]
        ES1 -- NO --> ES3["가이드 선택 화면"]
        ES3 --> ES3A["기존 가이드 선택 → guideId 저장"]
        ES3 --> ES3B["건강 가이드 생성 페이지로 이동"]
        ES3 --> ES3C["가이드 없이 사용 (noGuideMode)"]
    end

    %% ── 프론트엔드 ────────────────────────────────────────────────────
    ES2 & ES3A & ES3C --> FE1

    subgraph FE["🖥 프론트엔드 (React + Zustand)"]
        FE1{채팅 세션 있음?}
        FE1 -- NO --> FE2["POST /chat/sessions\n제목 = 첫 메시지 앞 20자"]
        FE2 --> FE3[세션 ID 저장]
        FE1 -- YES --> FE4
        FE3 --> FE4["POST /sessions/{id}/messages/stream\ncontent + guide_id 전송"]
        FE4 --> FE5{응답 10초 초과?}
        FE5 -- YES --> FE6["⏳ 지연 안내 표시"]
        FE5 -- NO --> BE1
        FE6 --> BE1
    end
    style FE fill:#fefce8,stroke:#facc15,color:#111

    %% ── 백엔드 ────────────────────────────────────────────────────────
    subgraph BE["⚙️ FastAPI 백엔드 (chat.py)"]
        BE1{JWT 인증}
        BE1 -- 실패 --> BE2[401 반환]
        BE1 -- 성공 --> BE3{위험 키워드?\n자살·자해·과다복용}
        BE3 -- YES --> BE4["🚨 즉시 반환 (LLM 미호출)\n자살예방상담전화 1393\n정신건강위기상담전화 1577-0199"]
        style BE4 fill:#fee2e2,stroke:#f87171,color:#111
        BE3 -- NO --> BE5{부적절 키워드?\n욕설·비속어}
        BE5 -- YES --> BE6["❌ 답변 거부"]
        style BE6 fill:#f1f5f9,stroke:#94a3b8,color:#111
        BE5 -- NO --> BE7["① 건강 프로필 조회\n성별·나이·기저질환·알레르기\n혈압·복용약·생활습관"]
        BE7 --> BE8{guide_id 있음?}
        BE8 -- YES --> BE9["② 가이드 컨텍스트 조회\n처방 약물·스케줄·지시사항\n질병코드+병명·drug_details"]
        style BE9 fill:#eff6ff,stroke:#60a5fa,color:#111
        BE8 -- NO --> BE10
        BE9 --> BE10["③ RAG 벡터 검색 (항상 실행)\n사용자 질문 → OpenAI 임베딩\n→ pgvector 코사인 유사도 검색\n→ 유사도 0.7 이상만 반환"]
        style BE10 fill:#f0fdf4,stroke:#86efac,color:#111
        BE10 --> BE11["Redis Publish\nchat:request:{session_id}\nhealth_profile + guide_context + rag_results"]
    end

    %% ── AI Worker (Tool Calling) ─────────────────────────────────────
    subgraph AI["🤖 AI Worker — Tool Calling (llm.py)"]
        BE11 --> AI1["Phase 1 — 도구 선택 (non-streaming)\ngpt-4o-mini + TOOLS 정의\ntool_choice=auto, max_tokens=200\n→ get_health_profile\n→ get_prescription_guide\n→ search_drug_info"]
        style AI1 fill:#eff6ff,stroke:#60a5fa,color:#111

        AI1 --> AI2{tool_calls 있음?}
        AI2 -- YES --> AI3["Phase 2 — 도구 실행\n사전 조회한 데이터에서\n필요한 컨텍스트만 반환\n(content: None 으로 Phase1 텍스트 폐기)"]
        style AI3 fill:#fefce8,stroke:#facc15,color:#111
        AI2 -- NO --> AI4

        AI3 --> AI4["Phase 3 — 스트리밍 응답\ngpt-4o-mini\n선택된 컨텍스트 + 대화 히스토리\nmax_tokens=600"]
        style AI4 fill:#f0fdf4,stroke:#86efac,color:#111

        AI4 --> AI5{히스토리 12개 초과?}
        AI5 -- YES --> AI6["이전 대화 요약\n최근 8개 유지"]
        AI5 -- NO --> AI7
        AI6 --> AI7["청크 Redis Publish\nchat:stream:{session_id}"]
    end
    style AI fill:#fdf4ff,stroke:#d946ef,color:#111

    %% ── 응답 ─────────────────────────────────────────────────────────
    subgraph RES["🖥 프론트엔드 (응답 수신)"]
        AI7 --> R1["NDJSON 청크 수신\n실시간 스트리밍 표시"]
        R1 --> R2(["💬 답변 완료"])
    end
    style RES fill:#fefce8,stroke:#facc15,color:#111
