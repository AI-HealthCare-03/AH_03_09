flowchart TD

    %% ── 처방전 → 가이드 ──────────────────────────────────────────────
    subgraph OCR_GUIDE["📄 처방전 → 가이드 생성"]
        G1([처방전 업로드]) --> G2["OCR 인식\n약품명·질병코드 추출"]
        G2 --> G3["가이드 생성\n복약 스케줄·지시사항 저장"]
        G3 --> G4["chatStore.guideId 저장\n(localStorage 영속)"]
    end
    style OCR_GUIDE fill:#eff6ff,stroke:#60a5fa,color:#111

    %% ── 챗봇 진입 (Empty State) ──────────────────────────────────────
    subgraph EMPTY["🖥 챗봇 진입"]
        G4 --> E1{guide_id 있음?}
        E1 -- YES --> E2["처방전 가이드 연동 안내"]
        E1 -- NO --> E3["가이드 선택 화면\n① 기존 가이드 선택\n② 새 가이드 생성하러 가기\n③ 가이드 없이 사용"]
    end
    style EMPTY fill:#fefce8,stroke:#facc15,color:#111

    %% ── 메시지 전송 ───────────────────────────────────────────────────
    E2 & E3 --> FE1

    subgraph FE["🖥 메시지 전송 (React)"]
        FE1["POST /sessions/{id}/messages/stream\ncontent + guide_id 전송"]
    end
    style FE fill:#fefce8,stroke:#facc15,color:#111

    %% ── 백엔드 ────────────────────────────────────────────────────────
    subgraph BE["⚙️ FastAPI (chat.py)"]
        FE1 --> BE1{위험 · 부적절 키워드?}
        BE1 -- YES --> BE2["🚨 즉시 응답\nLLM 미호출"]
        style BE2 fill:#fee2e2,stroke:#f87171,color:#111
        BE1 -- NO --> BE3["데이터 사전 조회\n① 건강 프로필\n② 가이드 컨텍스트 (guide_id 있을 때)\n③ RAG 벡터 검색 (pgvector)"]
        style BE3 fill:#f0fdf4,stroke:#86efac,color:#111
        BE3 --> BE4["Redis Publish → AI Worker"]
    end

    %% ── AI Worker (Tool Calling) ─────────────────────────────────────
    subgraph AI["🤖 AI Worker — Tool Calling (llm.py)"]
        BE4 --> AI1["Phase 1: 도구 선택\ngpt-4o-mini (non-streaming)\n사용자 질문에 맞는 도구 결정\n→ get_health_profile\n→ get_prescription_guide\n→ search_drug_info"]
        style AI1 fill:#eff6ff,stroke:#60a5fa,color:#111
        AI1 --> AI2["Phase 2: 도구 실행\n사전 조회한 데이터에서\n필요한 컨텍스트만 추출"]
        style AI2 fill:#fefce8,stroke:#facc15,color:#111
        AI2 --> AI3["Phase 3: 스트리밍 응답\ngpt-4o-mini\n선택된 컨텍스트로 최종 답변 생성"]
        style AI3 fill:#f0fdf4,stroke:#86efac,color:#111
        AI3 --> AI4["청크 Redis Publish\nchat:stream:{session_id}"]
    end
    style AI fill:#fdf4ff,stroke:#d946ef,color:#111

    %% ── 응답 ─────────────────────────────────────────────────────────
    subgraph RES["🖥 응답 수신"]
        AI4 --> R1["NDJSON 청크 수신\n실시간 스트리밍 표시"]
        R1 --> R2(["💬 답변 완료"])
    end
    style RES fill:#fefce8,stroke:#facc15,color:#111
