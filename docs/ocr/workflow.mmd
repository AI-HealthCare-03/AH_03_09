flowchart TD
    %% ────────────────────────────────────────────────────────────────
    %% ① 파일 업로드
    %% ────────────────────────────────────────────────────────────────
    subgraph UPLOAD["① 파일 업로드"]
        direction TB
        U1["사용자가 의료 문서 선택\n(이미지 또는 PDF, 최대 10MB)"]
        U1 --> U2{"파일 형식·크기\n검사"}
        U2 -->|"지원하지 않는 형식\n또는 용량 초과"| ER1["❌ 업로드 거절"]
        U2 -->|통과| U3{"이전에 올린\n동일 파일인지 확인"}
        U3 -->|"이미 있음"| ER2["❌ 중복 파일 안내\n기존 문서로 이동"]
        U3 -->|"새 파일"| U4["서버에 파일 저장"]
        U4 --> U5["처리 대기 상태로 등록\n(POST /ocr/upload → 202)"]
        U5 --> U6["AI 처리 대기열에 전달"]
    end

    %% ────────────────────────────────────────────────────────────────
    %% ② AI 자동 처리
    %% ────────────────────────────────────────────────────────────────
    subgraph WORKER["② AI 자동 처리 (백그라운드)"]
        direction TB
        W1["대기열에서 작업 수신"] --> W2["처리 중 상태로 변경"]
        W2 --> W3["Clova OCR로 문서 텍스트 추출"]
        W3 --> W4{"문서 종류 판단"}
        W4 -->|"처방전 또는 약봉투"| W5["GPT로 약물 정보·\n질병코드 파싱"]
        W4 -->|"기타 문서"| W6["텍스트만 저장\n(GPT 생략)"]
        W5 --> W7["약물·질병코드 DB 저장"]
        W6 --> W7
        W7 --> W8{"전체 인식 신뢰도\n70% 이상?"}
        W8 -->|"미달"| W9["재촬영 권고 플래그 설정"]
        W8 -->|"이상 없음"| W10["처리 완료 상태로 변경"]
        W9 --> W10
    end

    %% ────────────────────────────────────────────────────────────────
    %% ③ 처리 대기 화면
    %% ────────────────────────────────────────────────────────────────
    subgraph POLL["③ 처리 대기 화면"]
        direction TB
        P1["2초마다 처리 상태 확인\n(GET /ocr/jobs/job_id/status)"]
        P1 --> P2{"현재 상태?"}
        P2 -->|"대기 중 또는 처리 중"| P1
        P2 -->|"완료"| P3["결과 확인 화면으로 이동"]
        P2 -->|"실패"| P4{"재시도 가능?\n(최대 5회)"}
        P4 -->|"가능"| P5["재추출 요청\n(POST /ocr/records/record_id/reanalyze)"]
        P5 --> W1
        P4 -->|"횟수 초과"| P6["❌ 재업로드 안내"]
        P2 -->|"30초 이상 경과"| P7["⏳ 지연 안내 메시지 표시"]
        P7 --> P2
    end

    %% ────────────────────────────────────────────────────────────────
    %% ④ 결과 확인 및 수정
    %% ────────────────────────────────────────────────────────────────
    subgraph REVIEW["④ 결과 확인 및 수정"]
        direction TB
        R1["추출된 약물 목록 확인\n(신뢰도 70% 미달 시 재촬영 권고 배너 표시)"]
        R1 --> R1a{"결과 화면에서\n재추출 요청?"}
        R1a -->|"예"| R1b["재추출 요청\n(POST /ocr/records/record_id/reanalyze)"]
        R1a -->|"아니오"| R2{"약물 수정이\n필요한가?"}
        R2 -->|"약물 정보 수정"| R3["약물 편집\n(PATCH /medications/:id)"]
        R2 -->|"약물 누락"| R4["약물 직접 추가\n(약품 검색 자동완성 제공)"]
        R2 -->|"잘못된 약물"| R5["약물 삭제\n(DELETE /medications/:id)"]
        R2 -->|"수정 없음"| R_type{"처방전인가?"}
        R3 & R4 & R5 --> R_type
        R_type -->|"약봉투 또는 기타"| R10["전체 확인 완료 처리\n약물 및 질병코드 모두 확인"]
        R_type -->|"처방전"| R6["질병코드 확인"]
        R6 --> R7{"문서 종류 오분류\n또는 질병코드 오류?"}
        R7 -->|"문서 종류 잘못됨"| R8["문서 종류 재지정\n(재추출 자동 실행)"]
        R7 -->|"질병코드 오류"| R9["질병코드 직접 수정\n(ICD-10 코드 편집)"]
        R7 -->|"이상 없음"| R10
        R9 --> R10
    end

    %% ────────────────────────────────────────────────────────────────
    %% ⑤ 가이드 생성 요청
    %% ────────────────────────────────────────────────────────────────
    subgraph CONFIRM["⑤ 가이드 생성 요청\n(POST /ocr/jobs/job_id/confirm)"]
        direction TB
        C1{"복약 가이드\n생성 요청?"}
        C1 -->|"예"| C2["현재 문서의 약물·질병코드 수집"]
        C1 -->|"아니오"| C3["확인 완료\n(결과 화면 유지)"]
        C2 --> C5["내 다른 문서 중\n처리 완료된 최근 10개 함께 조회"]
        C5 --> C6["중복 약물 제거 후\n전체 데이터 통합"]
        C6 --> C7["가이드 생성 서비스로 전달\n(POST /guides/generate)"]
        C7 --> C4["가이드 생성 완료 대기 중\n(2초마다 상태 확인)"]
    end

    %% ────────────────────────────────────────────────────────────────
    %% 전체 흐름 연결
    %% ────────────────────────────────────────────────────────────────
    U6 --> W1
    U5 --> P1
    W10 --> P2
    P3 --> R1
    R1b --> W1
    R8 --> W1
    R10 --> C1

    %% ────────────────────────────────────────────────────────────────
    %% 신뢰도 표시 기준
    %% ────────────────────────────────────────────────────────────────
    subgraph LEGEND["신뢰도 표시 기준"]
        direction LR
        L1["🟢 높음 (80% 이상)\n정확도 양호"]
        L2["🟡 보통 (60~79%)\n일부 확인 권장"]
        L3["🔴 낮음 (60% 미만)\n직접 확인 필요"]
    end
