flowchart TD
    %% ────────────────────────────────────────────────────────────────
    %% ① 파일 업로드
    %% ────────────────────────────────────────────────────────────────
    subgraph UPLOAD["① 파일 업로드 (/upload)"]
        direction TB
        U1["파일 선택\n(드래그 앤 드롭 또는 버튼 클릭)\n1개 파일만 업로드 가능"]
        U1 --> U2{"클라이언트 사전 검사\n(MIME 타입·확장자·크기)"}
        U2 -->|"JPEG·PNG·PDF 아닌 형식"| UE1["❌ 형식 오류 토스트\n업로드 버튼 비활성"]
        U2 -->|"10MB 초과"| UE2["❌ 용량 초과 토스트\n업로드 버튼 비활성"]
        U2 -->|"통과"| U3["업로드 버튼 활성화"]
        U3 --> U4["POST /ocr/upload 요청\n(1개 파일)"]
        U4 --> U5{"서버 응답"}
        U5 -->|"422\n형식·크기 서버 재검증 실패\n또는 2개 이상 파일"| UE3["❌ 서버 측 형식 오류 안내"]
        U5 -->|"409\n동일 파일 SHA-256 중복"| UE4["❌ 중복 파일 안내\n'기존 문서 보기' 버튼 → /upload/result/:id"]
        U5 -->|"429\n일일 업로드 한도 초과"| UE5["❌ '오늘 업로드 한도에 도달했습니다'\n(일일 최대 20건)"]
        U5 -->|"202 성공\njob_id 수신"| U6["→ /upload/processing/:jobId 자동 이동"]
    end

    %% ────────────────────────────────────────────────────────────────
    %% ② AI 자동 처리 (백그라운드)
    %% ────────────────────────────────────────────────────────────────
    subgraph WORKER["② AI 처리 — ai_worker (백그라운드)"]
        direction TB
        W1["Redis 채널에서 작업 수신\n(ocr:request:{job_id})"]
        W1 --> W2["상태 PROCESSING으로 변경"]
        W2 --> W3["Clova OCR API 호출\n→ raw_text + 필드별 confidence 추출"]
        W3 --> W4{"Clova 응답 성공?"}
        W4 -->|"실패"| WF["상태 FAILED로 변경"]
        W4 -->|"성공"| W5["문서 유형 분류\n(PRESCRIPTION / DRUG_BAG / OTHER)"]
        W5 --> W6{"재추출 요청이며\n이전 수정 이력 존재?"}
        W6 -->|"있음\n(ocr_corrections 조회)"| W7["수정 이력을 few-shot 힌트로\nGPT 프롬프트에 주입\n(동일 오류 반복 방지)"]
        W6 -->|"없음 (최초 추출)"| W8["GPT 파싱 요청"]
        W7 --> W8
        W8 --> W9{"문서 유형"}
        W9 -->|"PRESCRIPTION"| W10["약물 정보 파싱\n+ 질병분류기호 ICD-10 파싱"]
        W9 -->|"DRUG_BAG"| W11["약물 정보만 파싱\n(질병코드는 반드시 빈 배열)"]
        W9 -->|"OTHER"| W12["텍스트만 저장\n(GPT 파싱 생략)"]
        W10 & W11 & W12 --> W13["medications / disease_codes\nDB 저장 (ocr_results 갱신)"]
        W13 --> W14{"전체 인식 신뢰도\n70% 이상?"}
        W14 -->|"미달"| W15["retake_recommended = true\n(재촬영 권고 플래그)"]
        W14 -->|"이상 없음"| W16["상태 DONE으로 변경"]
        W15 --> W16
    end

    %% ────────────────────────────────────────────────────────────────
    %% ③ 처리 대기 화면
    %% ────────────────────────────────────────────────────────────────
    subgraph POLL["③ 처리 대기 화면 (/upload/processing/:jobId)"]
        direction TB
        P1["2초마다 상태 폴링\n(GET /ocr/jobs/:jobId/status)"]
        P1 --> P2{"현재 상태"}
        P2 -->|"PENDING / PROCESSING"| P1
        P2 -->|"DONE\n재촬영 권고 없음"| P3["'결과 확인' 버튼 표시"]
        P2 -->|"DONE\n재촬영 권고 있음\n(confidence < 0.7)"| P3b["⚠ 재촬영 권고 배너 표시\n'결과 확인' 버튼 함께 표시"]
        P3 & P3b --> P3c["버튼 클릭 → /upload/result/:recordId"]
        P2 -->|"FAILED"| P4{"재추출 가능?\n(문서당 최대 5회)"}
        P4 -->|"가능"| P5["'재추출' 버튼 클릭\nPOST /records/:id/reanalyze"]
        P5 --> P5a["이전 수정 이력 few-shot 반영 후\nAI 재처리 시작"]
        P5a --> W1
        P4 -->|"5회 초과 (429)"| P6["❌ '재추출 횟수(5회)를 모두\n사용했습니다' 토스트\n새 파일 업로드 안내"]
    end

    %% ────────────────────────────────────────────────────────────────
    %% ④ 결과 확인 및 수정
    %% ────────────────────────────────────────────────────────────────
    subgraph REVIEW["④ 결과 확인 및 수정 (/upload/result/:recordId)"]
        direction TB
        R0["약물 목록 표시\n(필드별 신뢰도 색상 표시)"]

        R0 --> RDB{"DB 미매칭 약물 존재?"}
        RDB -->|"있음"| RDB1["⚠ 'DB에서 확인되지 않은 약물' 경고 배너\n약물명·성분명 직접 확인 권고"]
        RDB -->|"없음"| R_re
        RDB1 --> R_re

        R_re{"결과 화면에서\n'재추출' 버튼 클릭?"}
        R_re -->|"클릭 (5회 이내)"| R_re2["POST /records/:id/reanalyze\n→ /upload/processing/:jobId 이동"]
        R_re -->|"5회 초과"| R_re3["❌ '재추출 횟수(5회)를 모두\n사용했습니다' 토스트"]
        R_re3 --> R1
        R_re -->|"클릭 안 함"| R1{"약물 수정 필요?"}

        R1 -->|"✏ 편집 버튼 클릭"| R2["편집 모드 진입\n수정 가능 필드:\n용량·복약횟수·기간·복약시기"]
        R2 -->|"약물명·성분명 수정"| R2m["약물명/성분명 모달 열림\nDB 검색 자동완성 또는 직접 입력\nDB 선택 시 미매칭 경고 해제"]
        R2m -->|"선택/입력 완료"| R2
        R2 -->|"'저장' 클릭"| R2a["PATCH /medications/:id\n수정 이력 → ocr_corrections 저장"]
        R2 -->|"'취소' 클릭"| R2b["편집 종료 (변경 없음)"]

        R1 -->|"🗑 삭제 버튼 클릭"| R3["DELETE /medications/:id\n'약물이 삭제됐습니다' 토스트"]

        R1 -->|"+ 약물 추가 버튼 클릭"| R4["약품명 검색\n(GET /ocr/drugs/search)\n자동완성 목록 제공"]
        R4 --> R4a["약물 선택 또는 직접 입력\n→ POST /medications"]

        R1 -->|"수정 없음"| R5{"문서 유형 변경 필요?"}
        R2a & R2b & R3 & R4a --> R5

        R5 -->|"문서 유형 버튼 클릭\n(처방전·약봉투·기타 중 선택)"| R5a["PATCH /records/:id\n→ 즉시 변경 (재처리 없음)\n'문서 유형이 변경됐습니다' 토스트"]
        R5a --> R5
        R5 -->|"변경 없음"| R6{"약물 전체 확인?"}

        R6 -->|"'전체 확인' 버튼 클릭"| R6a["POST /medications/confirm\n→ 편집 잠금\n'확인 취소' 버튼 표시"]
        R6a --> R7
        R6 -->|"'확인 취소' 클릭\n(전체 확인 완료 상태)"| R6b["POST /medications/unconfirm\n→ 편집 잠금 해제"]
        R6b --> R6

        R7{"문서 유형"}
        R7 -->|"DRUG_BAG / OTHER"| R_end["약물 전체 확인 완료\n복약 가이드 생성 버튼 활성화"]
        R7 -->|"PRESCRIPTION"| R8["질병분류기호 섹션 표시\n(ICD-10 코드)"]

        R8 --> R9{"질병코드 수정 필요?"}
        R9 -->|"코드 직접 수정"| R9a["PATCH /disease-codes/:id\n수정 이력 → ocr_corrections 저장"]
        R9 -->|"이상 없음"| R10["'질병코드 확인' 버튼 클릭\nPOST /disease-codes/confirm"]
        R9a --> R10
        R10 --> R_end
    end

    %% ────────────────────────────────────────────────────────────────
    %% ⑤ 가이드 생성 요청
    %% ────────────────────────────────────────────────────────────────
    subgraph CONFIRM["⑤ 복약 가이드 생성 (결과 화면 상단 버튼)"]
        direction TB
        C0["약물 전체 확인 전:\n안내 배너 표시\n'복약 가이드 생성' 버튼 비활성"]
        C0 --> C0a["약물 목록을 검토한 후\n전체 확인 버튼을 누르고,\n복약 가이드 생성 버튼 클릭"]
        C0a --> C1["POST /ocr/jobs/:jobId/confirm\n{ trigger_guide: true }"]
        C1 --> C2["현재 문서 약물명 추출\n→ POST /guides/generate 호출"]
        C2 --> C3{"응답"}
        C3 -->|"guide_job_id 수신"| C4["/health-guide로 이동\n(가이드 생성 대기 화면)"]
        C3 -->|"실패"| C5["❌ '가이드 생성에 실패했습니다' 토스트"]
    end

    %% ────────────────────────────────────────────────────────────────
    %% ⑥ 내 문서 관리
    %% ────────────────────────────────────────────────────────────────
    subgraph DOCS["⑥ 내 문서 관리 (/documents)"]
        direction TB
        D1["문서 목록\n필터: 문서유형(전체·처방전·약봉투·기타)\n       처리상태(전체·대기·처리중·완료·실패)\n정렬: 최신순·오래된순 / 페이지네이션"]
        D1 --> D2{"문서 상태별 버튼"}
        D2 -->|"DONE"| D3["'결과보기'\n→ /upload/result/:id"]
        D2 -->|"PENDING · PROCESSING"| D4["'처리현황'\n→ /upload/processing/:jobId"]
        D2 -->|"FAILED"| D5["'재시도'\n→ POST /records/:id/reanalyze\n→ /upload/processing/:jobId"]
        D1 --> D6["'삭제' 버튼 → 삭제 확인 모달"]
        D6 -->|"확인"| D7["DELETE /records/:id (소프트 삭제)"]
        D7 -->|"PROCESSING 중 삭제 시도"| D8["❌ 409 삭제 불가\n'처리 완료 후 삭제 가능' 안내"]
        D7 -->|"성공"| D9["목록에서 즉시 제거"]
    end

    %% ────────────────────────────────────────────────────────────────
    %% 전체 흐름 연결
    %% ────────────────────────────────────────────────────────────────
    U6 --> P1
    W16 --> P2
    WF --> P2
    P3c --> R0
    R_re2 --> P1
    R_end --> C0

    %% ────────────────────────────────────────────────────────────────
    %% 신뢰도 표시 기준
    %% ────────────────────────────────────────────────────────────────
    subgraph LEGEND["신뢰도 표시 기준 (필드별 색상)"]
        direction LR
        L1["🟢 높음 (≥ 80%)\n정확도 양호"]
        L2["🟡 보통 (60 ~ 79%)\n일부 확인 권장"]
        L3["🔴 낮음 (< 60%)\n직접 확인 필요"]
    end
