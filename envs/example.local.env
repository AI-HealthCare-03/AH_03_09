# ── 환경 ─────────────────────────────────────────────────────────────────────
ENV=local

# ── FastAPI ──────────────────────────────────────────────────────────────────
SECRET_KEY=
COOKIE_DOMAIN=localhost

# ── DB (PostgreSQL) ──────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_EXPOSE_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# ── Kakao OAuth ──────────────────────────────────────────────────────────────
# 로컬 개발 시 카카오 개발자 콘솔에서 localhost redirect URI 등록 필요
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=http://localhost:3000/auth/kakao/callback

# ── OpenAI ───────────────────────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini      # 로컬 개발은 비용 절감을 위해 mini 사용
OPENAI_CHAT_MODEL=gpt-4o-mini

# ── Clova OCR ────────────────────────────────────────────────────────────────
CLOVA_OCR_INVOKE_URL=         # NOT "CLOVA_OCR_API_URL"
CLOVA_OCR_SECRET_KEY=

# ── Frontend ─────────────────────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000
