# ── Docker ───────────────────────────────────────────────────────────────────
DOCKER_USER=
DOCKER_REPOSITORY=

# ── 버전 관리 (deployment.sh 실행 시 자동 업데이트) ──────────────────────────
APP_VERSION=
AI_WORKER_VERSION=
FRONTEND_VERSION=

# ── 환경 ─────────────────────────────────────────────────────────────────────
ENV=production

# ── FastAPI ──────────────────────────────────────────────────────────────────
SECRET_KEY=
COOKIE_DOMAIN=                # 배포 도메인 (예: mediai.kro.kr)

# ── DB (PostgreSQL) ──────────────────────────────────────────────────────────
DB_HOST=postgres              # Docker Compose 네트워크 내 컨테이너 이름
DB_PORT=5432
DB_EXPOSE_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

# ── Kakao OAuth ──────────────────────────────────────────────────────────────
# 개인 개발자 비즈 앱 REST API 키 사용 (테스트 앱 X)
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=           # 예: https://mediai.kro.kr/auth/kakao/callback

# ── OpenAI ───────────────────────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o           # 배포 환경은 gpt-4o 사용 (개발 중엔 gpt-4o-mini)
OPENAI_CHAT_MODEL=gpt-4o

# ── Clova OCR ────────────────────────────────────────────────────────────────
CLOVA_OCR_INVOKE_URL=         # NOT "CLOVA_OCR_API_URL"
CLOVA_OCR_SECRET_KEY=

# ── Frontend ─────────────────────────────────────────────────────────────────
VITE_API_BASE_URL=            # 예: https://mediai.kro.kr (끝 슬래시 없이)
